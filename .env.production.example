APP_NAME=Integrix AI Call Center Pilot
ENVIRONMENT=production

# This file is a template. Values containing replace-with-* or .example are
# intentionally rejected by the app in ENVIRONMENT=production.

# Public host used by Caddy. Example: api.seudominio.com
DOMAIN=api.example.com
CADDY_EMAIL=admin@example.com

# Local Postgres service in docker-compose.production.yml
POSTGRES_DB=integrix
POSTGRES_USER=integrix
POSTGRES_PASSWORD=replace-with-strong-postgres-password
DATABASE_URL=postgresql+psycopg://integrix:replace-with-strong-postgres-password@postgres:5432/integrix

DB_ENABLED=true
DB_CONNECT_TIMEOUT_SECONDS=2.0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=5.0
DB_POOL_RECYCLE_SECONDS=1800

DATA_MODE=external_api
DEFAULT_TENANT=demo
TENANT_MAP={"+5511999999999":"tenant_demo"}
DEFAULT_TENANT_IMPLEMENTATION=pbsaude
TENANT_IMPLEMENTATION_MAP={}

CHAOS_ERROR_RATE=0.0
CHAOS_LATENCY_MS=0
LOG_LEVEL=INFO
AUTH_MAX_ATTEMPTS=2

EXTERNAL_API_BASE_URL=https://customer-api.example
EXTERNAL_API_AUTH_TYPE=basic
EXTERNAL_API_TOKEN=
EXTERNAL_API_USERNAME=replace-with-upstream-user
EXTERNAL_API_PASSWORD=replace-with-upstream-password
EXTERNAL_API_PROVIDER_SEARCH_PATH=/rest02/TNSCallCenter/busca-rede
EXTERNAL_API_TIMEOUT_SECONDS=8.0
EXTERNAL_API_MAX_RETRIES=1
EXTERNAL_API_RETRY_BACKOFF_SECONDS=0.2
EXTERNAL_API_MAX_CONNECTIONS=50
EXTERNAL_API_MAX_KEEPALIVE_CONNECTIONS=20
PROVIDER_MAX_RESULTS=3
EXTERNAL_API_TENANT_CONFIGS={}

AUTH_TIMEOUT_SECONDS=2.0
STATUS_TIMEOUT_SECONDS=2.0
PROVIDER_TIMEOUT_SECONDS=8.0

WEBHOOK_SECRET=replace-with-strong-vapi-webhook-secret
WEBHOOK_SECRET_HEADER=x-webhook-secret

SPECIALTIES_CSV_PATH=/app/data/especialidade.csv

VAPI_API_KEY=replace-with-vapi-api-key
VAPI_BASE_URL=https://api.vapi.ai
VAPI_CALLS_PATH=/call

OPS_DASHBOARD_TOKEN=replace-with-strong-ops-token
OPS_TOKEN_HEADER=x-ops-token
OPS_COST_SYNC_PAGE_SIZE=100
OPS_COST_SYNC_LOOKBACK_MINUTES=60

AUDIT_WRITE_MODE=async
AUDIT_QUEUE_MAX_SIZE=50000
AUDIT_BATCH_SIZE=100
AUDIT_FLUSH_INTERVAL_SECONDS=1.0

OPS_ALLOW_GLOBAL_QUERIES=false
CALL_EVENTS_RETENTION_DAYS=90
VAPI_COST_RETENTION_DAYS=365

WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60
