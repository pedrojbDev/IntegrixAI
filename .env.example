APP_NAME=Integrix AI Call Center Pilot
ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/integrix
DB_ENABLED=false
DB_CONNECT_TIMEOUT_SECONDS=2.0
DATA_MODE=mock
DEFAULT_TENANT=demo
TENANT_MAP={"\\+5511999999999":"tenant_demo"}
CHAOS_ERROR_RATE=0.0
CHAOS_LATENCY_MS=0
LOG_LEVEL=INFO
AUTH_MAX_ATTEMPTS=2
EXTERNAL_API_BASE_URL=https://customer-api.example
EXTERNAL_API_AUTH_TYPE=basic
EXTERNAL_API_TOKEN=
EXTERNAL_API_USERNAME=
EXTERNAL_API_PASSWORD=
EXTERNAL_API_PROVIDER_SEARCH_PATH=/rest02/TNSCallCenter/busca-rede
EXTERNAL_API_TIMEOUT_SECONDS=3.0
PROVIDER_MAX_RESULTS=3
EXTERNAL_API_TENANT_CONFIGS={}
AUTH_TIMEOUT_SECONDS=2.0
STATUS_TIMEOUT_SECONDS=2.0
PROVIDER_TIMEOUT_SECONDS=2.0
WEBHOOK_SECRET=
WEBHOOK_SECRET_HEADER=x-webhook-secret
SPECIALTIES_CSV_PATH=
VAPI_API_KEY=
VAPI_BASE_URL=https://api.vapi.ai
VAPI_CALLS_PATH=/call
OPS_DASHBOARD_TOKEN=
OPS_TOKEN_HEADER=x-ops-token
OPS_COST_SYNC_PAGE_SIZE=100
OPS_COST_SYNC_LOOKBACK_MINUTES=60
